{
  "openapi": "3.0.3",
  "info": {
    "title": "BOXMEOUT API",
    "version": "0.1.0",
    "description": "REST API for the BOXMEOUT decentralized boxing prediction market on Stellar."
  },
  "servers": [
    { "url": "http://localhost:3001", "description": "Local dev" }
  ],
  "tags": [
    { "name": "Health" },
    { "name": "Markets" },
    { "name": "Bets" },
    { "name": "Oracle" },
    { "name": "Admin" }
  ],
  "components": {
    "securitySchemes": {
      "AdminBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "ADMIN_API_KEY — required for /api/admin/* routes"
      },
      "OracleBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "ORACLE_API_KEY — required for POST /api/oracle/submit"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string", "example": "Market not found" },
          "code": { "type": "string", "example": "NOT_FOUND" }
        }
      },
      "Fighter": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "Canelo Alvarez" },
          "record": { "type": "string", "example": "60-2-2" },
          "nationality": { "type": "string", "example": "Mexico" },
          "weightClass": { "type": "string", "example": "Super Middleweight" }
        }
      },
      "Market": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "abc123" },
          "contractAddress": { "type": "string", "example": "CABC..." },
          "fighterA": { "$ref": "#/components/schemas/Fighter" },
          "fighterB": { "$ref": "#/components/schemas/Fighter" },
          "scheduledAt": { "type": "string", "format": "date-time" },
          "bettingEndsAt": { "type": "string", "format": "date-time" },
          "status": {
            "type": "string",
            "enum": ["Open", "Locked", "Resolved", "Cancelled", "Disputed"]
          },
          "outcome": { "type": "string", "nullable": true, "example": null },
          "poolA": { "type": "string", "example": "500000000" },
          "poolB": { "type": "string", "example": "300000000" },
          "totalPool": { "type": "string", "example": "800000000" },
          "oracleAddress": { "type": "string", "example": "GABC..." },
          "createdBy": { "type": "string", "example": "GABC..." }
        }
      },
      "MarketStats": {
        "type": "object",
        "properties": {
          "totalBets": { "type": "integer", "example": 142 },
          "uniqueBettors": { "type": "integer", "example": 89 },
          "poolA": { "type": "string", "example": "500000000" },
          "poolB": { "type": "string", "example": "300000000" },
          "totalVolume": { "type": "string", "example": "800000000" },
          "impliedOddsA": { "type": "number", "example": 62.5 },
          "impliedOddsB": { "type": "number", "example": 37.5 }
        }
      },
      "Bet": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "bet_xyz" },
          "marketId": { "type": "string", "example": "abc123" },
          "bettor": { "type": "string", "example": "GABC..." },
          "side": { "type": "string", "enum": ["FighterA", "FighterB"] },
          "amount": { "type": "string", "example": "10000000" },
          "placedAt": { "type": "string", "format": "date-time" },
          "claimed": { "type": "boolean" },
          "payout": { "type": "string", "nullable": true, "example": null }
        }
      },
      "Portfolio": {
        "type": "object",
        "properties": {
          "totalStaked": { "type": "string", "example": "1500000000" },
          "totalWinnings": { "type": "string", "example": "2100000000" },
          "pendingClaims": { "type": "string", "example": "350000000" },
          "activeBets": { "type": "integer", "example": 3 },
          "completedBets": { "type": "integer", "example": 12 },
          "roi": { "type": "number", "example": 40.0 }
        }
      },
      "OracleResult": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "marketId": { "type": "string" },
          "outcome": { "type": "string", "enum": ["FighterA", "FighterB", "Draw", "NoContest"] },
          "source": { "type": "string", "example": "BoxRec" },
          "reportedBy": { "type": "string" },
          "reportedAt": { "type": "string", "format": "date-time" },
          "confirmed": { "type": "boolean" }
        }
      },
      "Oracle": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "address": { "type": "string", "example": "GABC..." },
          "name": { "type": "string", "example": "BoxRec Bot" },
          "active": { "type": "boolean" }
        }
      },
      "AuditLog": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "userId": { "type": "string" },
          "actionType": { "type": "string" },
          "details": { "type": "object" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "PaginatedMarkets": {
        "type": "object",
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Market" } },
          "page": { "type": "integer" },
          "limit": { "type": "integer" }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Health check",
        "description": "Returns API and database status.",
        "responses": {
          "200": {
            "description": "Healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" },
                    "db": { "type": "string", "example": "connected" }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Degraded — database unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "degraded" },
                    "db": { "type": "string", "example": "disconnected" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/markets": {
      "get": {
        "tags": ["Markets"],
        "summary": "List markets",
        "description": "Returns a paginated list of boxing markets.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": { "type": "string", "enum": ["Open", "Locked", "Resolved", "Cancelled", "Disputed"] }
          },
          { "name": "weightClass", "in": "query", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20, "maximum": 100 } }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of markets",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaginatedMarkets" }
              }
            }
          }
        }
      }
    },
    "/api/markets/search": {
      "get": {
        "tags": ["Markets"],
        "summary": "Full-text market search",
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaginatedMarkets" }
              }
            }
          },
          "400": {
            "description": "q parameter missing",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/markets/{id}": {
      "get": {
        "tags": ["Markets"],
        "summary": "Get market by ID",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Market detail",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "data": { "$ref": "#/components/schemas/Market" } }
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/markets/{id}/stats": {
      "get": {
        "tags": ["Markets"],
        "summary": "Get market stats",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Aggregate stats",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "data": { "$ref": "#/components/schemas/MarketStats" } }
                }
              }
            }
          }
        }
      }
    },
    "/api/markets/{id}/bets": {
      "get": {
        "tags": ["Markets"],
        "summary": "Get bets for a market",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": {
            "description": "List of bets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/Bet" } },
                    "page": { "type": "integer" },
                    "limit": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/bets/payout-estimate": {
      "get": {
        "tags": ["Bets"],
        "summary": "Estimate payout",
        "description": "Returns a hypothetical payout. Does not place a real bet. Rate-limited to 30 req/min.",
        "parameters": [
          { "name": "market_id", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "side", "in": "query", "required": true, "schema": { "type": "string", "enum": ["FighterA", "FighterB"] } },
          { "name": "amount", "in": "query", "required": true, "schema": { "type": "string", "description": "Stake in stroops" } }
        ],
        "responses": {
          "200": {
            "description": "Estimated payout",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": { "estimatedPayout": { "type": "string", "example": "18600000" } }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "429": {
            "description": "Rate limited",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/bets/{address}": {
      "get": {
        "tags": ["Bets"],
        "summary": "Get bets by wallet address",
        "parameters": [
          { "name": "address", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Stellar public key (G...)" },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["pending", "won", "lost", "claimed"] } },
          { "name": "marketId", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Bets for address",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Bet" } }
              }
            }
          },
          "400": {
            "description": "Invalid Stellar address",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/bets/{address}/portfolio": {
      "get": {
        "tags": ["Bets"],
        "summary": "Get portfolio summary for a wallet",
        "parameters": [
          { "name": "address", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Portfolio summary (zero-value for unknown addresses)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Portfolio" }
              }
            }
          },
          "400": {
            "description": "Invalid address",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/oracle/submit": {
      "post": {
        "tags": ["Oracle"],
        "summary": "Submit a fight result",
        "security": [{ "OracleBearer": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["market_id", "outcome", "source"],
                "properties": {
                  "market_id": { "type": "string" },
                  "outcome": { "type": "string", "enum": ["FighterA", "FighterB", "Draw", "NoContest"] },
                  "source": { "type": "string", "example": "BoxRec" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Oracle result created",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OracleResult" } } }
          },
          "401": {
            "description": "Unauthorized",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/oracle/results": {
      "get": {
        "tags": ["Oracle"],
        "summary": "List all oracle submissions (admin)",
        "security": [{ "AdminBearer": [] }],
        "responses": {
          "200": {
            "description": "List of oracle results",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/OracleResult" } }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/admin/markets/pending": {
      "get": {
        "tags": ["Admin"],
        "summary": "List markets pending resolution",
        "security": [{ "AdminBearer": [] }],
        "responses": {
          "200": {
            "description": "Locked markets without confirmed oracle results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/Market" } }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/admin/markets/resolve": {
      "post": {
        "tags": ["Admin"],
        "summary": "Confirm oracle result and trigger on-chain resolution",
        "security": [{ "AdminBearer": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["oracle_result_id"],
                "properties": {
                  "oracle_result_id": { "type": "integer", "example": 42 }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resolution triggered",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "status": { "type": "string", "example": "ok" } }
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "401": {
            "description": "Unauthorized",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/admin/markets/dispute/resolve": {
      "post": {
        "tags": ["Admin"],
        "summary": "Resolve a disputed market with admin override",
        "security": [{ "AdminBearer": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["dispute_id", "override_outcome"],
                "properties": {
                  "dispute_id": { "type": "string", "format": "uuid" },
                  "override_outcome": { "type": "string", "enum": ["FighterA", "FighterB", "Draw", "NoContest"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Dispute resolved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "status": { "type": "string", "example": "ok" } }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/admin/oracles": {
      "get": {
        "tags": ["Admin"],
        "summary": "List all registered oracles",
        "security": [{ "AdminBearer": [] }],
        "responses": {
          "200": {
            "description": "Oracle list",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Oracle" } }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      },
      "post": {
        "tags": ["Admin"],
        "summary": "Register a new oracle",
        "security": [{ "AdminBearer": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["address", "name"],
                "properties": {
                  "address": { "type": "string", "example": "GABC..." },
                  "name": { "type": "string", "example": "BoxRec Bot" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Oracle created",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Oracle" } } }
          },
          "400": {
            "description": "Validation error",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "401": {
            "description": "Unauthorized",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/admin/oracles/{id}": {
      "patch": {
        "tags": ["Admin"],
        "summary": "Update oracle name or active status",
        "security": [{ "AdminBearer": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "active": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Oracle updated",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Oracle" } } }
          },
          "400": {
            "description": "No fields provided",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "401": {
            "description": "Unauthorized",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      },
      "delete": {
        "tags": ["Admin"],
        "summary": "Deactivate (soft-delete) an oracle",
        "security": [{ "AdminBearer": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Oracle deactivated",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Oracle" } } }
          },
          "401": {
            "description": "Unauthorized",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/admin/audit-logs": {
      "get": {
        "tags": ["Admin"],
        "summary": "Get audit logs",
        "security": [{ "AdminBearer": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20, "maximum": 100 } },
          { "name": "userId", "in": "query", "schema": { "type": "string" } },
          { "name": "actionType", "in": "query", "schema": { "type": "string" } },
          { "name": "startDate", "in": "query", "schema": { "type": "string", "format": "date-time" } },
          { "name": "endDate", "in": "query", "schema": { "type": "string", "format": "date-time" } }
        ],
        "responses": {
          "200": {
            "description": "Paginated audit logs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/AuditLog" } },
                    "page": { "type": "integer" },
                    "limit": { "type": "integer" },
                    "total": { "type": "integer" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid date format",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "401": {
            "description": "Unauthorized",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    }
  }
}
